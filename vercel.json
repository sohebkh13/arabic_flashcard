{
  "buildCommand": "pnpm --filter mobile run build:web",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/deepl/:path*", "destination": "/api/deepl" },
    { "source": "/api/sync/:path*", "destination": "/api/sync" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
