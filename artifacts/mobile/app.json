{
  "expo": {
    "name": "Tarjim",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1a"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for voice input to transcribe Arabic words"
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW"
      ],
      "minSdkVersion": 33,
      "targetSdkVersion": 36
    },
    "web": {
      "favicon": "/favicon.ico",
      "publicUrl": "/",
      "scope": "/",
      "shortName": "Tarjim"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
